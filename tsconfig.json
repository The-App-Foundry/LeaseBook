{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    ".storybook",
    "vite.config.ts",
    ".storybook/stories/layout/FilterBar.stories.tsx",
    ".storybook/stories/ui/Badge.stories.tsx",
    ".storybook/stories/ui/Button.stories.tsx",
    ".storybook/stories/ui/Card.stories.tsx",
    ".storybook/stories/ui/Dropdown.stories.tsx",
    ".storybook/stories/ui/SearchBar.stories.tsx",
    ".storybook/stories/ui/Sort.stories.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
