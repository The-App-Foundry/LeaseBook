{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    // TypeScript's wildcard expansion skips dot-prefixed directories, so a bare
    // ".storybook" entry silently contributes ZERO files — which is why the
    // story paths below used to be enumerated by hand, and why stories missing
    // from that list escaped typechecking entirely. Glob explicitly instead.
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx"
  ],
  "exclude": ["graphify-out"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
